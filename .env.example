# Copy this file to .env and fill in the key. Never share .env.
OPENROUTER_API_KEY=sk-or-v1-...
# Supabase (business data). Service key: never share, never put in the web front-end.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=
# Meta Marketing API (step by step in META.md). Token of the BM system user: never share.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
# META_IG_USER_ID=
# META_SYNC_MIN=60
# Optional: override the default image model
# IMAGE_MODEL=google/gemini-2.5-flash-image
